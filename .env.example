# ==========================================
# SMART RESUME SCREENER - ENVIRONMENT CONFIG
# ==========================================

# Database Connection (SQLite by default; replace with PostgreSQL in production)
DATABASE_URL=sqlite:///./screener.db

# LLM Configuration (Supports OpenAI, Groq, Ollama, OpenRouter, Gemini-compatible)
# Leave empty to utilize the high-precision built-in deterministic semantic engine (Zero-Setup)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Security & Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt,docx,md
UPLOADS_DIR=./backend/data/uploads

# App Environment
APP_ENV=development
DEBUG=true
