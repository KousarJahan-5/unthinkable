# Database Configuration (SQLite default, easily replace with postgresql://user:pass@localhost/dbname)
DATABASE_URL=sqlite:///./screener.db

# LLM Configuration (OpenAI-compatible API: OpenAI, Groq, Ollama, OpenRouter, Gemini OpenAI-endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Application Settings
APP_ENV=development
DEBUG=true
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt,docx,md
UPLOADS_DIR=./data/uploads
